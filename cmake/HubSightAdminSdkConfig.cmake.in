@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.6 COMPONENTS Core Network WebSockets)
if(@HUBSIGHT_ADMIN_HSCFG_AVAILABLE@)
    find_dependency(OpenSSL COMPONENTS Crypto)
    find_dependency(PkgConfig)
    pkg_check_modules(HUBSIGHT_ARGON2 REQUIRED IMPORTED_TARGET libargon2)
    pkg_check_modules(HUBSIGHT_LIBZIP REQUIRED IMPORTED_TARGET libzip)
    pkg_check_modules(HUBSIGHT_LIBYAML REQUIRED IMPORTED_TARGET yaml-0.1)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/HubSightAdminSdkTargets.cmake")
